# Copy to .env.local for local development with `vercel dev`

# Neon — use the POOLED connection string (host contains "-pooler") from:
# Neon console → your project → Connect → "Connection pooling" on
# It looks like: postgresql://[user]:[password]@ep-[name]-pooler.[region].aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://[user]:[password]@ep-[name]-pooler.[region].aws.neon.tech/neondb?sslmode=require

# Auth — generate with: openssl rand -base64 32
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# CORS — set to your Vercel frontend URL in production
CORS_ORIGIN=http://localhost:3000

# Admin panel access (/admin) — comma-separated usernames, case-insensitive. Nobody is an
# admin by default; there is no UI to grant this, it's checked server-side against this list
# on every admin request.
ADMIN_USERNAMES=your_username_here
